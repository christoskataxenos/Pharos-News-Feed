# Pharos configuration — copy to `.env` and adjust as needed.
# All variables are OPTIONAL.

# --- Admin credentials (advanced / IaC deployments) ---
# If BOTH of these are set, they take priority over the DB-backed admin and the
# first-run setup wizard is skipped entirely. Leave them unset to use the
# in-browser setup wizard on first launch instead.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Database ---
# Async SQLAlchemy URL. Defaults to a local SQLite file if unset.
# DATABASE_URL=sqlite+aiosqlite:///./feedhub.db
